# Base URL of the fleet Worker (celld dev default).
# The browser only calls same-origin /api/*; Next.js rewrites it here, so the
# Worker never needs CORS headers and FLEET_URL is never exposed to the client.
FLEET_URL=http://127.0.0.1:9876

# Optional Paperclip agent directory. Both values are server-only; never use a
# NEXT_PUBLIC_ prefix. Leave them unset to hide the Paperclip rail section.
# PAPERCLIP_URL=https://paperclip.example.com
# PAPERCLIP_API_KEY=
